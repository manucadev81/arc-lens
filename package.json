{
	"name": "arc-lens",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -b",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"boundaries": "tsx scripts/check-boundaries.ts",
		"test": "vitest run",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm validate:data && pnpm test && pnpm build",
		"validate:data": "tsx scripts/validate-data.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^22.20.5",
		"oxc-parser": "^0.158.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1"
	}
}
